# ---------------------------------------------------------------------------
# PostHog analytics
#
# Copy this file to .env.local for local development, and set the same values
# in Netlify (Site configuration > Environment variables) for deploys.
#
# Get the key from: PostHog > Settings > Project > Project API Key
# This is the PUBLIC project key (starts with "phc_"), not a personal API key.
#
# Leave unset to disable PostHog entirely — nothing is sent.
#
# NOTE: this site is a static export, so these are baked in at BUILD time.
#       Changing them requires a redeploy to take effect.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_ME_WITH_YOUR_POSTHOG_PROJECT_KEY

# US Cloud (default): https://us.i.posthog.com
# EU Cloud:           https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
